# Database Configuration (self-hosted Postgres, e.g. cPanel)
# Either set DATABASE_URL directly...
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/your_db_name
# ...or leave DATABASE_URL unset and use these discrete vars instead:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=your_db_user
# PGPASSWORD=your_db_password
# PGDATABASE=your_db_name

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Server Configuration
NODE_ENV=development
PORT=5000

# CORS
FRONTEND_URL=http://localhost:3000

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
EMAIL_FROM=Crawford University Appraisal System <noreply@crawforduniversity.edu.ng>
